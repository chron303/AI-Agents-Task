# Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Gemini API ────────────────────────────────────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# The model identifier for Gemini 3.5 Flash-Lite (as of September 2026)
# Do NOT change this unless Google releases a newer identifier.
GEMINI_MODEL=gemini-3.5-flash-lite

# ── Optional: Storyboard reference images ──────────────────────────────────────
# If left unset, this defaults to imagen-3.0-generate-001 (same model Agent 2 uses).
# Storyboard generation works perfectly well without this — the image is optional.
GEMINI_IMAGE_MODEL=imagen-3.0-generate-001
